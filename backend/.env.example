# --- Azure Face API ---
AZURE_FACE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_FACE_KEY=your-azure-key
AZURE_TIMEOUT=10
# Résilience : nb de tentatives supplémentaires + base du backoff exponentiel.
AZURE_MAX_RETRIES=2
AZURE_BACKOFF_BASE=0.5

# --- Stockage (optionnel, valeurs par défaut sous backend/data) ---
# DATA_DIR=
# DB_PATH=
# REFERENCES_DIR=

# --- Reconnaissance ---
HEADPOSE_PITCH_MAX=15
HEADPOSE_YAW_MAX=15
DEEPFACE_MODEL=VGG-Face
# Borne anti-blocage d'une vérification DeepFace (secondes).
DEEPFACE_TIMEOUT=20

# --- Auto-enrôlement ---
# Enregistre automatiquement comme référence « Visage N » tout visage net,
# de face, et non reconnu. Renommable ensuite depuis l'interface.
AUTO_ENROLL=true
# Seuils head pose stricts pour ne capturer qu'un visage bien frontal.
AUTO_ENROLL_PITCH_MAX=8
AUTO_ENROLL_YAW_MAX=8
AUTO_ENROLL_ROLL_MAX=12
# Ignore les visages dont la largeur < 8 % de la frame (trop petits/flous).
AUTO_ENROLL_MIN_WIDTH_RATIO=0.08

# --- Action déclenchée à la reconnaissance ---
# none | log | command | webhook
RECOGNITION_ACTION=log
# Pour RECOGNITION_ACTION=command (variables disponibles: {name} {confidence})
# Exemple Linux/macOS : notify-send "Reconnu" "{name}"
# Exemple Windows     : notepad.exe
RECOGNITION_COMMAND=
# L'exécution de commandes est désactivée par défaut (surface d'abus).
# Mettre à true UNIQUEMENT dans un environnement de confiance pour l'activer.
ALLOW_COMMAND_ACTION=false
# Pour RECOGNITION_ACTION=webhook
RECOGNITION_WEBHOOK_URL=

# --- Sécurité / API ---
# Laisser vide pour désactiver l'authentification.
# OBLIGATOIRE si ENV=production : le backend refuse de démarrer sans clé.
API_KEY=
# development | production
ENV=development
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# --- Limites d'entrée (anti-DoS) ---
MAX_IMAGE_BYTES=8388608
MAX_UPLOAD_BYTES=8388608
HISTORY_LIMIT_MAX=200
# Limitation de débit par IP (format slowapi « nombre/période »). Vide = désactivé.
RATE_LIMIT=60/minute

# --- Journalisation / conformité (PII) ---
# Masque les noms reconnus dans les logs. Mettre à false uniquement en dev.
LOG_MASK_PII=true
# Format des logs : text (lisible) ou json (structuré, pour ingestion/SIEM).
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Rétention de l'historique ---
# Purge des événements plus vieux que N jours (0 = désactivé).
HISTORY_TTL_DAYS=30
# Plafond dur du nombre de lignes conservées (0 = illimité).
HISTORY_MAX_ROWS=10000
