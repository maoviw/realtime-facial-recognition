# --- Mode proxy serveur (recommandé, R6) ---
# Par défaut, le frontend appelle son proxy same-origin /api/proxy/* qui relaie
# vers le backend en injectant la clé API CÔTÉ SERVEUR. Ces deux variables
# (sans préfixe NEXT_PUBLIC_) restent sur le serveur Next.js et ne sont jamais
# envoyées au navigateur.
BACKEND_ORIGIN=http://localhost:8000
# Clé API serveur (doit correspondre à API_KEY du backend ; vide si désactivée).
API_KEY=

# --- Mode direct (dev/legacy, optionnel) ---
# Si défini, le frontend appelle directement le backend (court-circuite le proxy).
# ATTENTION : NEXT_PUBLIC_API_KEY est alors intégrée au bundle navigateur et donc
# LISIBLE par le client — ce n'est PAS un secret. Préférez le mode proxy.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_KEY=
